# Weather API keys
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# WeatherAPI.com — free tier, 3-day forecast
# Sign up: https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=your_key_here

# OpenWeatherMap — free tier, 5-day/3h forecast
# Sign up: https://home.openweathermap.org/users/sign_up
OPENWEATHER_KEY=your_key_here

# Pirate Weather — free tier, 2000 calls/day (HRRR/NBM ensemble)
# Sign up: https://pirateweather.net/getting-started
PIRATEWEATHER_KEY=your_key_here

# -----------------------------------------------------------
# Polymarket CLOB API credentials (for --buy flag)
# -----------------------------------------------------------

# Required: your wallet private key
# Export from polymarket.com → Cash → ⋮ → Export Private Key
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: signature type (default: 0)
#   0 = EOA wallet (MetaMask, hardware wallet, direct private key)
#   1 = Email / Magic wallet
#   2 = Browser wallet proxy
POLYMARKET_SIG_TYPE=0

# Optional: funder address (only needed for sig types 1 or 2)
# This is the address that holds your USDC on Polymarket
# POLYMARKET_FUNDER=0xYOUR_FUNDER_ADDRESS
